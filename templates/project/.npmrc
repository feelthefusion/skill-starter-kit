# Skill Starter Kit — install hygiene (security-gate layer 5)
ignore-scripts=true      # install-time scripts are the primary npm supply-chain payload
min-release-age=7        # days; skip versions younger than a week (npm >= 11.10). Compromised releases are usually pulled within hours.
save-exact=true          # no ^ranges — the lockfile is the truth
fund=false
audit=false              # osv-scanner in verify.sh covers this with MAL- records too
